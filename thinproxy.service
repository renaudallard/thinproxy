[Unit]
Description=thinproxy lightweight HTTP/HTTPS proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/thinproxy
Restart=on-failure
RestartSec=5

# Each connection can hold two descriptors, so the 512-connection
# default needs more than the common 1024 soft limit.
LimitNOFILE=2048

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
