[Unit]
Description=thinproxy lightweight HTTP/HTTPS proxy
After=network.target

[Service]
Type=simple
# -F forces foreground so a config "daemon yes" cannot make the service exit
ExecStart=/usr/local/bin/thinproxy -F
Restart=on-failure
RestartSec=5

# Each connection can hold two descriptors, so the 512-connection
# default needs more than the common 1024 soft limit.
LimitNOFILE=2048

# Run as an unprivileged, transient system user. thinproxy only needs to
# read its config, /etc/resolv.conf and /etc/hosts, so no static account is
# required; do not set a "user" directive in the config alongside this.
DynamicUser=yes

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
